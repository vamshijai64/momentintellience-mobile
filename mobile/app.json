{
  "expo": {
    "name": "AI Cricket Coach",
    "slug": "moment-intelligence-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cricsense_logo_transparent.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/cricsense_logo_transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf9f6"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.momentintelligencemobile",
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/cricsense_logo_transparent.png",
        "backgroundColor": "#faf9f6"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AI Cricket Coach to access camera for shot analysis.",
          "microphonePermission": "Allow AI Cricket Coach to record audio."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AI Cricket Coach to access your gallery videos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec7a9349-3452-4d21-94d1-1125d9b91780"
      }
    }
  }
}
